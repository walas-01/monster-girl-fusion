# Development server only. Process environment variables take precedence.
# Optional: copy to .env without overwriting existing local settings.
# Restart Vite after changing these values.
DEV_PORT=5173
DEV_API_TARGET=http://localhost:3000

# /api paths are forwarded unchanged to the independently running backend.
# These settings are not browser variables; do not rename them with VITE_.
# Never put secrets in VITE_ variables: they are exposed to the client bundle.
