{
  "name": "monster-girl-fusion-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.2.2 <13"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "better-sqlite3": false
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --test tests/app.test.ts tests/server.test.ts tests/database.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
