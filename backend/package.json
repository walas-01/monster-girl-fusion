{
  "name": "monster-girl-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import=tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test --test-timeout=15000 tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "google-auth-library": "11.3.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
