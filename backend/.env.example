# Local development only. Real environment variables take precedence.
# Copy this file to .env; npm run dev loads it using Node's native support.
# npm start reads the process environment without loading .env.
# Restart the development server after editing .env.
PORT=3000

# Without DATABASE_PATH, development creates backend/data/game.sqlite.
# Custom paths are relative to backend/ and their parent directory must already exist.
# Create backend/storage/ before enabling this example:
# DATABASE_PATH=storage/game.sqlite
# Production requires an explicit absolute DATABASE_PATH in the process environment.
# Keep actual storage outside src/, dist/ and node_modules/, including through links.
